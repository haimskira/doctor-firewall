# Normalize everything to LF in the repo; Linux prod and containers expect LF.
* text=auto eol=lf

# Windows-native scripts keep CRLF (Windows PowerShell 5.1 friendly).
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# POSIX scripts and container files must be LF or they break inside Linux.
*.sh          text eol=lf
Dockerfile*   text eol=lf
*.conf        text eol=lf
.githooks/*   text eol=lf

# Binary artefacts (should never be committed, but never mangle them either).
*.png  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.tar  binary
*.gz   binary
*.whl  binary
*.tgz  binary
