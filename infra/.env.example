# Doctor Firewall — deployment settings (copy to infra/.env). NO SECRETS HERE:
# passwords and keys live in infra/secrets/ (scripts/init-secrets.*), never in this file.

# Image tag to run (set by scripts/install-online / install-offline; "dev" for local builds).
DF_VERSION=0.1.0

# Registry images (written by scripts/install-online). Empty = local names
# (doctor-firewall/api:$DF_VERSION ...). Docker Hub example:
#   DF_IMAGE_API=haim1418/doctor-firewall:api-0.5.0
DF_IMAGE_API=
DF_IMAGE_WEB=
DF_IMAGE_POSTGRES=
DF_IMAGE_REDIS=

# Published HTTPS endpoint of the UI/API gateway.
DF_HTTPS_BIND=0.0.0.0
DF_HTTPS_PORT=443

# Logging: DEBUG | INFO | WARNING | ERROR
DF_LOG_LEVEL=INFO

# Internal trust store (PEM) that signs the FMC certificate. Verification is always on.
DF_FMC_CA_FILE=./trust/fmc-ca.pem

# Sign-in providers, comma separated: local | ldap | tacacs (docs/authentication.md).
# Local accounts always keep working (break-glass administrator).
DF_AUTH_PROVIDERS=local

# LDAP / Active Directory — LDAPS (or ldap:// with DF_LDAP_START_TLS=true), CA in
# infra/trust/ldap-ca.pem, service account password in infra/secrets/ldap_bind_password.
DF_LDAP_URL=
DF_LDAP_START_TLS=false
DF_LDAP_BIND_DN=
DF_LDAP_USER_BASE=
# DF_LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
# role=group DN pairs separated by ";" — roles then follow the directory at every sign-in.
# Empty: an administrator creates each LDAP account and assigns its roles locally.
DF_LDAP_GROUP_ROLES=

# TACACS+ (e.g. Cisco ISE) — shared secret in infra/secrets/tacacs_secret.
DF_TACACS_HOST=
DF_TACACS_PORT=49
DF_TACACS_SERVICE=shell
# Authorization attribute with the roles (df-role=optimizer,approver). Empty: roles stay local.
DF_TACACS_ROLE_ATTRIBUTE=df-role

# Directory holding ui.pem + ui.key for the HTTPS gateway (org PKI, or scripts/gen-certs --ui).
DF_UI_TLS_DIR=./certs/ui
