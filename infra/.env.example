# Doctor Firewall — deployment settings (copy to infra/.env). NO SECRETS HERE:
# passwords and keys live in infra/secrets/ (scripts/init-secrets.*), never in this file.

# Image tag to run (set by scripts/install-online / install-offline; "dev" for local builds).
DF_VERSION=0.1.0

# Image name prefix: <prefix>api, <prefix>web ... Empty = local names (doctor-firewall/api).
# Docker Hub example: DF_IMAGE_PREFIX=myuser/doctor-firewall-
DF_IMAGE_PREFIX=

# Published HTTPS endpoint of the UI/API gateway.
DF_HTTPS_BIND=0.0.0.0
DF_HTTPS_PORT=443

# Logging: DEBUG | INFO | WARNING | ERROR
DF_LOG_LEVEL=INFO

# Internal trust store (PEM) that signs the FMC certificate. Verification is always on.
DF_FMC_CA_FILE=./trust/fmc-ca.pem

# Directory holding ui.pem + ui.key for the HTTPS gateway (org PKI, or scripts/gen-certs --ui).
DF_UI_TLS_DIR=./certs/ui
